// Cloudflare Workers（Static Assets）の設定：public/ の中を静的サイトとして公開する
// public/index.html は build.mjs が作る（Cloudflare 側ではビルドしない）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "almighty-genkan",
  "compatibility_date": "2026-10-30",
  // 公開 URL（workers.dev）を常に ON にする。お試し公開（Preview URL）は使わない
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public"
  }
}
